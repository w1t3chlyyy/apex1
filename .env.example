# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Служебный (сервисный) бот: уведомления и авторизация владельцев ---
TELEGRAM_SERVICE_BOT_TOKEN=123456:ABC-service-bot-token

# --- Публичный URL этого сервиса (для установки вебхуков Telegram Business) ---
PUBLIC_BASE_URL=https://your-domain.com

# Порог уверенности RAG для автоответа
RAG_CONFIDENCE_THRESHOLD=0.75
