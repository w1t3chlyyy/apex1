# --- Supabase (тот же проект, что и у Next.js) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Qwen (Alibaba Cloud DashScope, OpenAI-совместимый режим) ---
QWEN_API_KEY=your-qwen-or-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# --- Служебный бот: уведомления владельцу об эскалации ---
TELEGRAM_SERVICE_BOT_TOKEN=123456:ABC-service-bot-token

# Обязателен. Тот же, что TELEGRAM_WEBHOOK_SECRET в Vercel (только A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=

PUBLIC_BASE_URL=https://your-domain.com

# Те же значения, что и в Vercel
FREE_TIER_TOKEN_LIMIT=15000
HUMAN_TAKEOVER_HOURS=12
