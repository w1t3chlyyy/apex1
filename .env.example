# --- Supabase (тот же проект, что и у Next.js) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Служебный (сервисный) бот: используется ЗДЕСЬ только для отправки
# уведомлений владельцу об эскалации (notify_owner). Обработка ответа
# владельца перенесена в Next.js (app/api/bot/webhook/route.ts) — см. bot.py.
TELEGRAM_SERVICE_BOT_TOKEN=123456:ABC-service-bot-token

# --- Публичный URL ЭТОГО сервиса. Используется только в документации/для
# ручной проверки. Реальный вебхук для каждого бота-агента регистрирует
# сам Next.js (через PYTHON_SERVICE_URL в его .env) при подключении токена
# в личном кабинете — вручную вызывать setWebhook не нужно.
PUBLIC_BASE_URL=https://your-domain.com

# Порог уверенности RAG для автоответа (используется как fallback, если у
# конкретного бота в таблице `bots` не задан confidence_threshold)
RAG_CONFIDENCE_THRESHOLD=0.75
