# --- Supabase (тот же проект, что и у Next.js) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Qwen (Alibaba Cloud DashScope, OpenAI-совместимый режим) ---
QWEN_API_KEY=your-qwen-or-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# --- Служебный (сервисный) бот: используется здесь только для уведомлений
# владельцу об эскалации (notify_owner). Ответ владельца и админ-панель
# обрабатываются в Next.js (app/api/bot/webhook/route.ts).
TELEGRAM_SERVICE_BOT_TOKEN=123456:ABC-service-bot-token

PUBLIC_BASE_URL=https://your-domain.com

# Порог уверенности RAG для автоответа (fallback, если у бота в таблице
# `bots` не задан confidence_threshold)
RAG_CONFIDENCE_THRESHOLD=0.75
